    {
      "name": "clk",
      "dir": "in",
      "width": 1
    },
    {
      "name": "arst",
      "dir": "in",
      "width": 1
    },
    {
      "name": "i",
      "dir": "in",
      "width": 1
    },
    {
      "name": "j",
      "dir": "in",
      "width": 1
    },
    {
      "name": "q",
      "dir": "out",
      "width": 3
    }
  ],
  "timeScale": "NS",
  "durationNs": 500,
  "tickResNs": 1,
  "systemClockMhz": 50
}
