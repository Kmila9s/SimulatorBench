      "name": "clk",
      "dir": "in",
      "width": 1
    },
    {
      "name": "se",
      "dir": "in",
      "width": 2
    },
    {
      "name": "D",
      "dir": "in",
      "width": 4
    },
    {
      "name": "Dl",
      "dir": "in",
      "width": 1
    },
    {
      "name": "Dr",
      "dir": "in",
      "width": 1
    },
    {
      "name": "Q",
      "dir": "out",
      "width": 4
    }
  ],
  "timeScale": "NS",
  "durationNs": 80,
  "tickResNs": 1,
  "systemClockMhz": 100
}
