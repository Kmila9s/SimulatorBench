{
  "version": 2,
  "id": "005-encoder-8to3",
  "title": "8-to-3 priority encoder (with...select + after delays)",
  "sourceUrl": "https://github.com/JulyWitch/vhdl_ghdl_examples/tree/master/encoder",
  "license": "unspecified",
