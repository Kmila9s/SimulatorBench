      "dir": "in",
      "width": 8
    },
    {
      "name": "y",
      "dir": "out",
      "width": 3
    }
  ],
  "timeScale": "NS",
  "durationNs": 600,
  "tickResNs": 1,
  "systemClockMhz": 50,
